# Copy to xlsx-autopsy.toml (gitignored) and point at a local workbook.
# Secrets still come from the workbook XML, not from this file.

[xlsx_autopsy]
workbook_path = "workbook.xlsx"
output_dir = "out"
sst_truncate = 5000

